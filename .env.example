# 网页引航员自动读取项目根目录 .env；CLI 仍使用 PowerShell / bash 环境变量。
LLM_API_KEY=
# 阿里云百炼北京地域；API Key 必须来自同一地域。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
# 单次模型请求的网络空闲等待上限，单位秒；连接10秒、写入30秒，均受剩余预算约束。
LLM_REQUEST_TIMEOUT_SECONDS=120
# 一次Agent运行（含多个模型/工具轮次）的协作式总预算，单位秒。
GUIDE_RUN_TIMEOUT_SECONDS=300
# 数据库路径仅从启动环境变量读取；在 .env 中填写此项暂不生效。
# 不设置环境变量时使用项目根目录下的 .runtime/campus.sqlite3。
CAMPUS_DB_PATH=
